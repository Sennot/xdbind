{
  "geode": "5.10.0",
  "gd": { "win": "2.2081" },
  "id": "sennot.macro_binds",
  "name": "Macro Binds",
  "version": "v1.0.1",
  "developer": "Sennot",
  "description": "A separate macro hotkey menu for xdBot. Load only, without the success popup.",
  "dependencies": {
    "zilko.xdbot": { "version": ">=v2.7.7", "importance": "required" }
  },
  "settings": {
    "enabled": { "type": "bool", "name": "Enabled", "default": true },
    "open-menu": { "type": "keybind", "name": "Open Menu", "default": "F8" }
  },
  "tags": ["utility"]
}
